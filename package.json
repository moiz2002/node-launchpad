{
  "name": "node-docker-app",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npx prisma generate && NODE_ENV=development tsx watch src/index.ts",
    "staging": "npx prisma generate && NODE_ENV=staging tsx watch src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "mysql2": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "prisma": "^7.9.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
